<Project>
  <PropertyGroup>
    <!-- C# and VB projects. $(Language) is not set yet at this point, so gate on the project extension. -->
    <_WebFormsGeneratorEnabled>false</_WebFormsGeneratorEnabled>
    <_WebFormsGeneratorEnabled Condition="'$(EnableWebFormsDesignerGenerator)'=='true' AND ('$(MSBuildProjectExtension)'=='.csproj' OR '$(MSBuildProjectExtension)'=='.vbproj')">true</_WebFormsGeneratorEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(_WebFormsGeneratorEnabled)'=='true'">
    <Analyzer Include="$(MSBuildSDKSystemWebWebFormsGeneratorPath)" Condition="Exists('$(MSBuildSDKSystemWebWebFormsGeneratorPath)')" />

    <!--
      The MSBuild.SDK.SystemWeb SDK already includes the Web Forms markup as Content (see EnableWebFormsDefaultItems).
      Hand those files to the compiler as AdditionalFiles so the generator can see them.
      If EnableWebFormsDefaultItems is false, add the markup files as AdditionalFiles in the project instead.
    -->
    <_WebFormsMarkupFiles Include="@(Content->WithMetadataValue('Extension', '.aspx'))" />
    <_WebFormsMarkupFiles Include="@(Content->WithMetadataValue('Extension', '.ascx'))" />
    <_WebFormsMarkupFiles Include="@(Content->WithMetadataValue('Extension', '.master'))" />
    <!--
      Every Web.config: the root one applies to all markup, one in a subfolder only to the markup below it (ASP.NET configuration inheritance).
      DefaultItemExcludes deliberately is not used here: MSBuild.SDK.SystemWeb adds web.config to it.
    -->
    <_WebFormsMarkupFiles Include="**\Web.config" Exclude="$(DefaultWebFormsItemExcludes);$(BaseOutputPath)**;$(BaseIntermediateOutputPath)**;**\node_modules\**" />
    <AdditionalFiles Remove="@(_WebFormsMarkupFiles)" />
    <AdditionalFiles Include="@(_WebFormsMarkupFiles)" />

    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

  <!--
    Precompiled publish with merge (PrecompileBeforePublish + UseMerge in a publish profile): Visual Studio's
    Microsoft.Web.Publishing.AspNetCompileMerge.targets needs assembly attributes for the merged assembly and looks for a
    Compile item literally named AssemblyInfo, which SDK-style projects do not have (theirs is generated into obj). Supplying
    @(AssemblyAttributes) is the pipeline's documented alternative, so derive them from the project's own properties unless
    the project provided attributes or pointed at a file itself. GetAspNetMergePath runs right before the attribute-based
    generation target, so hooking after it places these items before that target's condition is evaluated.
  -->
  <Target Name="_MSBuildSDKSystemWebWebFormsMergeAssemblyAttributes"
          AfterTargets="GetAspNetMergePath"
          Condition="'$(UseMerge)'=='true' AND '@(AssemblyAttributes)'=='' AND '$(_AssemblyInfoSource)'=='' AND '$(AssemblyInfoDll)'==''">
    <PropertyGroup>
      <_WebFormsMergeAssemblyTitle>$(AssemblyTitle)</_WebFormsMergeAssemblyTitle>
      <_WebFormsMergeAssemblyTitle Condition="'$(_WebFormsMergeAssemblyTitle)'==''">$(SingleAssemblyName)</_WebFormsMergeAssemblyTitle>
      <_WebFormsMergeAssemblyTitle Condition="'$(_WebFormsMergeAssemblyTitle)'==''">$(AssemblyName)</_WebFormsMergeAssemblyTitle>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttributes Include="AssemblyTitle" Condition="'$(_WebFormsMergeAssemblyTitle)'!=''">
        <value>$(_WebFormsMergeAssemblyTitle)</value>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyProduct" Condition="'$(Product)'!=''">
        <value>$(Product)</value>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyCompany" Condition="'$(Company)'!=''">
        <value>$(Company)</value>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyCopyright" Condition="'$(Copyright)'!=''">
        <value>$(Copyright)</value>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyDescription" Condition="'$(Description)'!=''">
        <value>$(Description)</value>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyVersion" Condition="'$(AssemblyVersion)'!=''">
        <value>$(AssemblyVersion)</value>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyFileVersion" Condition="'$(FileVersion)'!=''">
        <value>$(FileVersion)</value>
      </AssemblyAttributes>
    </ItemGroup>
    <Message Importance="normal" Text="Merged assembly attributes derived from project properties (title '$(_WebFormsMergeAssemblyTitle)', version '$(AssemblyVersion)')." />
  </Target>

  <Target Name="_MSBuildSDKSystemWebWebFormsCheckSdk" BeforeTargets="BeforeBuild;CoreCompile" Condition="'$(UsingMSBuildSDKSystemWeb)'!='true'">
    <Error Code="SWWF900" Text="KfbSoft.MSBuild.SDK.SystemWeb.WebForms must be used together with the MSBuild.SDK.SystemWeb project SDK (&lt;Project Sdk=&quot;MSBuild.SDK.SystemWeb&quot;&gt;)." />
  </Target>
</Project>
