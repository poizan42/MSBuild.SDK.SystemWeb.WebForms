<?xml version="1.0" encoding="utf-8"?>
<!--
  Precompiled, merged file-system publish, the equivalent of an old Web Site's "precompile + merge" deployment.
  Run with Visual Studio's MSBuild (the SystemWeb SDK imports Microsoft.WebApplication.targets):

    msbuild ExampleWebFormsApplication.csproj -p:Configuration=Release -p:DeployOnBuild=true -p:PublishProfile=Precompiled

  Needs aspnet_merge.exe from the Windows SDK ("NETFX 4.8 Tools"). The merged assembly's attributes are derived from the
  project properties by KfbSoft.MSBuild.SDK.SystemWeb.WebForms; add <AssemblyAttributes> items here to override them.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <publishUrl>..\..\publish\ExampleWebFormsApplication</publishUrl>
    <DeleteExistingFiles>True</DeleteExistingFiles>
    <!-- Precompile the markup and merge the page assemblies into one; the code-behind stays in the project assembly. -->
    <PrecompileBeforePublish>True</PrecompileBeforePublish>
    <EnableUpdateable>False</EnableUpdateable>
    <DebugSymbols>False</DebugSymbols>
    <UseMerge>True</UseMerge>
    <!-- Must differ from the project's own assembly name. -->
    <SingleAssemblyName>ExampleWebFormsApplication.Views</SingleAssemblyName>
    <!-- The SystemWeb SDK's Release-mode view compilation would clean up the publish output; precompilation covers it. -->
    <MvcBuildViews>False</MvcBuildViews>
  </PropertyGroup>
</Project>
