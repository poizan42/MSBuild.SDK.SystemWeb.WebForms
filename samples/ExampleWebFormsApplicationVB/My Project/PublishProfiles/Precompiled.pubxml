<?xml version="1.0" encoding="utf-8"?>
<!--
  Precompiled, merged file-system publish. Run with Visual Studio's MSBuild:

    msbuild ExampleWebFormsApplicationVB.vbproj -p:Configuration=Release -p:DeployOnBuild=true -p:PublishProfile=Precompiled

  See the C# sample's profile for the details.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <publishUrl>..\..\publish\ExampleWebFormsApplicationVB</publishUrl>
    <DeleteExistingFiles>True</DeleteExistingFiles>
    <PrecompileBeforePublish>True</PrecompileBeforePublish>
    <EnableUpdateable>False</EnableUpdateable>
    <DebugSymbols>False</DebugSymbols>
    <UseMerge>True</UseMerge>
    <SingleAssemblyName>ExampleWebFormsApplicationVB.Views</SingleAssemblyName>
    <MvcBuildViews>False</MvcBuildViews>
  </PropertyGroup>
</Project>
